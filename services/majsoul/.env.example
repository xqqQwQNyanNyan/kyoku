# 仅服务运营者配置。不要把填写后的副本放进安装包。
# 国际中文服（繁体中文）账号密码登录；第三方登录账号不能直接使用此方式。
MJS_BASE='https://game.maj-soul.com/1'
MJS_USERNAME=''
MJS_PASSWORD=''

# 可选：已有的 oauth2Login access_token；须与 MJS_BASE 所在服匹配。
# ACCESS_TOKEN 非空时优先使用 token，不使用上面的用户名密码。
# ACCESS_TOKEN=''
# MJS_LOGIN_TYPE=10
# Unity 资源版本来自官方登录画面；改版后可覆盖内置版本。
# MJS_RESOURCE_VERSION='0.16.274'
# 可选：服务发现不可用时，填写已验证的官方 wss 网关。
# Unity 网关同时需要线路列表返回的 MJS_ROUTE_ID。
# MJS_GATEWAY='wss://.../gateway'
# MJS_ROUTE_ID='route-2'
HOST=127.0.0.1
PORT=2563
